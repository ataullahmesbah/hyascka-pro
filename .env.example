# ---------------------------------------------------------------------------
# HYASCKA — environment
# Copy to .env.local (Next.js runtime) and .env (Prisma CLI), then fill in.
# Never commit real values. Only NEXT_PUBLIC_* is ever exposed to the browser.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PRD §40.2) -------------------------------------------------------
# DATABASE_URL = Neon POOLED endpoint (contains "-pooler") used by the app.
# DIRECT_URL   = non-pooled endpoint, used by Prisma Migrate only.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/hyascka?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/hyascka?sslmode=require"

# Auth -----------------------------------------------------------------------
# Generate: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_DAYS="7"

# Seeded owner account (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@hyascka.com"
SEED_ADMIN_PASSWORD="ChangeMe#2026"

# Email — Resend free tier, or SMTP (PRD §28 adapter) ------------------------
EMAIL_PROVIDER="console"          # console | resend | smtp
EMAIL_FROM="HYASCKA <hello@hyascka.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Telegram alerts ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Media — Cloudinary first, storage adapter allows S3/R2 later ---------------
STORAGE_PROVIDER="local"          # local | cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Rate limiting / cache — Upstash Redis (PRD §40.5) --------------------------
# Left empty the app falls back to an in-process limiter (single instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Background jobs — QStash/Inngest (PRD §40.4) -------------------------------
JOBS_PROVIDER="inline"            # inline | qstash
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
JOB_WEBHOOK_SECRET=""

# Reserved — placeholders for adapters that are stubbed, not yet wired.
# Leaving them empty changes nothing today.
# Payments — gateway secrets stay server-side (PRD §43) ----------------------
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# AI assistant — Google Gemini (PRD §7 of v5) --------------------------------
# Empty: the site chat widget stays hidden and /api/chat returns 503.
# The assistant only ever sees published site content — see src/lib/ai/knowledge.ts.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Tracking — server-side secret only (PRD §44.2) -----------------------------
META_CAPI_ACCESS_TOKEN=""
META_CAPI_DATASET_ID=""

# Monitoring -----------------------------------------------------------------
SENTRY_DSN=""

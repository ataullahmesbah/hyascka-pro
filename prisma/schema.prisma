// HYASCKA — Prisma schema
// Implements PRD Part I §19 (baseline model) + Part II §49 (payment/tracking/
// maintenance entities). Indexing is explicit and deliberate per §40.3: every
// foreign key, every frequently filtered column, and every sort/pagination
// column is indexed at schema level — not deferred to "later".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint for the app runtime — PRD §40.2
  url       = env("DATABASE_URL")
  // Non-pooled endpoint reserved for migrations only
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  PROJECT_MANAGER
  EDITOR
  SUPPORT
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
  PENDING_VERIFICATION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum PricingModel {
  FIXED
  STARTING_FROM
  CUSTOM_QUOTE
  MONTHLY_RETAINER
  HIDDEN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RequestStatus {
  SUBMITTED
  IN_REVIEW
  OFFER_SENT
  ACCEPTED
  REJECTED
  CONVERTED
  IN_PROGRESS
  DELIVERED
  CLOSED
  CANCELLED
}

/**
 * What a row on a request's timeline represents.
 */
enum RequestUpdateKind {
  NOTE
  STATUS
  CANCELLATION
}

enum OrderStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentMethodKey {
  BKASH
  NAGAD
  BANK_TRANSFER
  SSLCOMMERZ
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum NotificationType {
  LEAD_CREATED
  CONTACT_SUBMITTED
  CLIENT_CREATED
  MESSAGE_RECEIVED
  PROJECT_UPDATED
  REQUEST_UPDATED
  REQUEST_QUOTED
  DOCUMENT_SHARED
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  INVOICE_OVERDUE
  TICKET_UPDATED
  SECURITY_ALERT
  SYSTEM_ALERT
}

enum DeliveryChannel {
  IN_APP
  EMAIL
  TELEGRAM
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
}

// ===========================================================================
// IDENTITY  (PRD §9, §12)
// ===========================================================================

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  emailVerifiedAt  DateTime?
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  role             Role       @default(CLIENT)
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clientProfile      ClientProfile?
  sessions           Session[]
  tokens             VerificationToken[]
  permissions        UserPermission[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  messages           Message[]
  conversationSeats  ConversationParticipant[]
  assignedLeads      Lead[]                    @relation("LeadOwner")
  leadNotes          LeadNote[]
  projectSeats       ProjectMember[]
  tasksAssigned      Task[]                    @relation("TaskAssignee")
  uploads            MediaAsset[]
  blogPosts          BlogPost[]
  verifiedPayments   Payment[]                 @relation("PaymentVerifier")
  submittedPayments  Payment[]                 @relation("PaymentSubmitter")
  approvedExpenses   Expense[]                 @relation("ExpenseApprover")
  createdExpenses    Expense[]                 @relation("ExpenseCreator")
  ticketsAssigned    SupportTicket[]           @relation("TicketAssignee")
  requestUpdates     ServiceRequestUpdate[]
  ticketMessages     TicketMessage[]
  activities         ProjectActivity[]
  refundsCreated     Refund[]
  adjustmentsCreated Adjustment[]

  @@index([role, status])
  @@index([createdAt])
  @@index([status])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Per-user permission grants layered on top of the role matrix (PRD §12).
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

// ===========================================================================
// CRM  (PRD §17)
// ===========================================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  industry  String?
  size      String?
  country   String?
  createdAt DateTime @default(now())

  clients ClientProfile[]

  @@index([name])
}

model ClientProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  companyId    String?
  companyName  String?
  billingEmail String?
  billingPhone String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  country      String?
  taxId        String?
  notes        String?
  onboardedAt  DateTime?
  referralCode String?   @unique
  referredBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?         @relation(fields: [companyId], references: [id])
  projects  Project[]
  invoices  Invoice[]
  orders    Order[]
  requests  ServiceRequest[]
  tickets   SupportTicket[]
  documents ClientDocument[]
  leads     Lead[]

  @@index([companyId])
  @@index([createdAt])
}

model Lead {
  id          String     @id @default(cuid())
  reference   String     @unique
  /**
   * The client account behind the enquiry, when there is one. An enquiry from
   * someone already signed in belongs in their portal, not only in a mailbox.
   */
  clientId    String?
  /**
   * The service request this enquiry opened, so the two never drift apart.
   */
  requestId   String?    @unique
  name        String
  email       String
  phone       String?
  company     String?
  budget      String?
  serviceId   String?
  message     String
  source      String     @default("website")
  status      LeadStatus @default(NEW)
  ownerId     String?
  ipAddress   String?
  userAgent   String?
  convertedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner   User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  service Service?        @relation(fields: [serviceId], references: [id])
  client  ClientProfile?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  request ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  notes   LeadNote[]

  @@index([clientId])
  @@index([status])
  @@index([ownerId])
  @@index([serviceId])
  @@index([createdAt])
  @@index([email])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@index([leadId])
  @@index([authorId])
}

// ===========================================================================
// SERVICES  (PRD §8)
// ===========================================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  services Service[]

  @@index([position])
}

model Service {
  id               String        @id @default(cuid())
  categoryId       String?
  title            String
  slug             String        @unique
  tagline          String?
  shortDescription String
  longDescription  String
  icon             String?
  coverImage       String?
  deliverables     String[]
  technologies     String[]
  processSteps     Json?
  timeline         String?
  pricingModel     PricingModel  @default(STARTING_FROM)
  startingPrice    Decimal?      @db.Decimal(12, 2)
  currency         String        @default("BDT")
  status           ContentStatus @default(PUBLISHED)
  featured         Boolean       @default(false)
  position         Int           @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  features     ServiceFeature[]
  packages     ServicePackage[]
  faqs         ServiceFAQ[]
  leads        Lead[]
  requests     ServiceRequest[]
  orders       OrderItem[]
  projects     Project[]
  invoiceItems InvoiceItem[]

  @@index([categoryId])
  @@index([status, featured])
  @@index([position])
  @@index([createdAt])
}

model ServiceFeature {
  id        String  @id @default(cuid())
  serviceId String
  title     String
  detail    String?
  position  Int     @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServicePackage {
  id           String       @id @default(cuid())
  serviceId    String
  name         String
  summary      String?
  price        Decimal?     @db.Decimal(12, 2)
  currency     String       @default("BDT")
  pricingModel PricingModel @default(FIXED)
  billingCycle String?
  features     String[]
  highlighted  Boolean      @default(false)
  position     Int          @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceFAQ {
  id        String @id @default(cuid())
  serviceId String
  question  String
  answer    String
  position  Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// ===========================================================================
// SALES  (PRD §19 Sales domain)
// ===========================================================================

model ServiceRequest {
  id        String        @id @default(cuid())
  reference String        @unique
  clientId  String
  serviceId String?
  title     String
  brief     String
  budget    String?
  deadline  DateTime?
  status    RequestStatus @default(SUBMITTED)
  /**
   * 0-100, shown to the client so "how far along is it" has an answer.
   */
  progress  Int           @default(0)

  /**
   * Cancellation. A client may withdraw a request outright until staff confirm
   * an order against it; after that they can only ask, and staff decide — which
   * is why the request and the decision are two separate timestamps.
   */
  cancelRequestedAt DateTime?
  cancelReason      String?
  cancelledAt       DateTime?

  /**
   * Files the client attached when they asked.
   */
  attachments Json?

  /**
   * What we quoted for this piece of work, and what the client did about it.
   * The price is ours to set; accepting or declining is theirs, which is why
   * the quote and the decision are separate timestamps.
   */
  quotedAmount  Decimal?  @db.Decimal(12, 2)
  quoteCurrency String    @default("USD")
  quoteNote     String?
  quotedAt      DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  /**
   * Set when staff confirm the work after the client accepted.
   */
  confirmedAt   DateTime?
  /**
   * Signed off and finished. Closing is the last word on a piece of work: the
   * final check happens before it, so a closed request is read-only for the
   * client — no new messages, tickets or cancellations against it.
   */
  closedAt      DateTime?
  closeNote     String?
  /**
   * True for work a client described themselves rather than picking from the catalogue.
   */
  isCustom      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientProfile          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service?               @relation(fields: [serviceId], references: [id])
  proposals Proposal[]
  updates   ServiceRequestUpdate[]
  tickets   SupportTicket[]
  invoices  Invoice[]
  projects  Project[]
  lead      Lead?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
}

/**
 * One entry on a service request's shared timeline.
 * Both sides write here — staff answering a brief, a client replying, a status
 * change, a cancellation — so the client's dashboard and the staff view are the
 * same conversation rather than two half-records that have to be reconciled.
 */
model ServiceRequestUpdate {
  id          String            @id @default(cuid())
  requestId   String
  authorId    String
  kind        RequestUpdateKind @default(NOTE)
  body        String
  /**
   * [{ url, name, mimeType, sizeBytes }] — images and PDFs.
   */
  attachments Json?
  /**
   * Internal notes stay on the staff side and are never sent to the client.
   */
  internal    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
  @@index([authorId])
}

model Proposal {
  id         String    @id @default(cuid())
  requestId  String
  title      String
  body       String
  amount     Decimal?  @db.Decimal(12, 2)
  currency   String    @default("BDT")
  validUntil DateTime?
  accepted   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Order {
  id        String      @id @default(cuid())
  reference String      @unique
  clientId  String
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(12, 2)
  currency  String      @default("BDT")
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  invoices Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  serviceId String?
  title     String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
}

// ===========================================================================
// PROJECTS  (PRD §10, §42.5)
// ===========================================================================

model Project {
  id          String        @id @default(cuid())
  reference   String        @unique
  clientId    String
  serviceId   String?
  /**
   * The request this project came out of, when it came from one.
   */
  requestId   String?
  name        String
  slug        String        @unique
  summary     String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  currency    String        @default("BDT")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client     ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service    Service?          @relation(fields: [serviceId], references: [id])
  request    ServiceRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  members    ProjectMember[]
  tickets    SupportTicket[]
  milestones Milestone[]
  tasks      Task[]
  files      ProjectFile[]
  activities ProjectActivity[]

  @@index([clientId])
  @@index([serviceId])
  @@index([requestId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleLabel String   @default("Member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  title     String
  detail    String?
  dueDate   DateTime?
  status    MilestoneStatus @default(PENDING)
  position  Int             @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  milestoneId String?
  assigneeId  String?
  title       String
  detail      String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId, status])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([dueDate])
}

model ProjectFile {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  url             String
  mimeType        String?
  sizeBytes       Int?
  visibleToClient Boolean  @default(true)
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([projectId, createdAt])
  @@index([actorId])
}

model ClientDocument {
  id        String   @id @default(cuid())
  clientId  String
  title     String
  category  String   @default("CONTRACT")
  url       String
  createdAt DateTime @default(now())

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ===========================================================================
// FINANCE  (PRD §13, §43)
// ===========================================================================

model Account {
  id        String   @id @default(cuid())
  name      String
  type      String // BANK | CASH | MOBILE_WALLET | GATEWAY | OTHER
  currency  String   @default("BDT")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([type])
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  clientId   String
  orderId    String?
  /**
   * The service request this invoice bills, so a payment can name its service.
   */
  requestId  String?
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  subtotal   Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)
  tax        Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  currency   String        @default("BDT")
  notes      String?
  issuedAt   DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client      ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  order       Order?          @relation(fields: [orderId], references: [id])
  request     ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]
  refunds     Refund[]
  adjustments Adjustment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([orderId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  /**
   * What this line is for, so an invoice says which service it bills.
   */
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@index([serviceId])
}

model Payment {
  id              String           @id @default(cuid())
  reference       String           @unique
  invoiceId       String
  method          PaymentMethodKey
  amount          Decimal          @db.Decimal(12, 2)
  currency        String           @default("BDT")
  /// PRD §43.3 — a transaction id may never be reused across invoices.
  trxId           String?          @unique
  proofUrl        String?
  senderNumber    String?
  status          PaymentStatus    @default(PENDING_VERIFICATION)
  submittedById   String?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  gatewayPayload  Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  submittedBy User?    @relation("PaymentSubmitter", fields: [submittedById], references: [id])
  verifiedBy  User?    @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  refunds     Refund[]

  @@index([invoiceId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([submittedById])
}

model Expense {
  id           String        @id @default(cuid())
  reference    String        @unique
  category     String
  vendor       String?
  description  String?
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("BDT")
  spentAt      DateTime      @default(now())
  receiptUrl   String?
  status       ExpenseStatus @default(SUBMITTED)
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())

  createdBy  User? @relation("ExpenseCreator", fields: [createdById], references: [id])
  approvedBy User? @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([status])
  @@index([category])
  @@index([spentAt])
  @@index([createdAt])
}

model Transaction {
  id          String          @id @default(cuid())
  reference   String          @unique
  accountId   String?
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("BDT")
  description String
  relatedType String?
  relatedId   String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  account Account? @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([type])
  @@index([occurredAt])
  @@index([relatedType, relatedId])
}

model Refund {
  id          String   @id @default(cuid())
  reference   String   @unique
  paymentId   String
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("BDT")
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@index([createdAt])
}

model Adjustment {
  id          String   @id @default(cuid())
  reference   String   @unique
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([invoiceId])
}

// ===========================================================================
// COMMUNICATION  (PRD §15)
// ===========================================================================

model Conversation {
  id            String   @id @default(cuid())
  subject       String
  clientUserId  String?
  projectId     String?
  isArchived    Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@index([clientUserId])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  /// Internal notes are never returned to a CLIENT session (PRD §15).
  isInternalNote Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  name      String
  url       String
  mimeType  String?
  sizeBytes Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model SupportTicket {
  id         String       @id @default(cuid())
  reference  String       @unique
  clientId   String
  /**
   * The service request this ticket is about, when it is about one. A client
   * complaining after delivery is complaining about something specific, and
   * staff should not have to guess which engagement from the subject line.
   */
  requestId  String?
  /**
   * Or about a live project, for work already under way.
   */
  projectId  String?
  subject    String
  category   String       @default("GENERAL")
  priority   Priority     @default(MEDIUM)
  status     TicketStatus @default(OPEN)
  assigneeId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  client   ClientProfile   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  request  ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages TicketMessage[]

  @@index([requestId])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([assigneeId])
  @@index([createdAt])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// ===========================================================================
// NOTIFICATIONS  (PRD §16)
// ===========================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, read])
  @@index([createdAt])
  @@index([type])
}

model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String
  channel        DeliveryChannel
  status         DeliveryStatus  @default(QUEUED)
  attempts       Int             @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
}

model NotificationPreference {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  inApp    Boolean          @default(true)
  email    Boolean          @default(true)
  telegram Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model NotificationTemplate {
  id           String           @id @default(cuid())
  type         NotificationType @unique
  title        String
  body         String
  emailSubject String?
  emailBody    String?
  updatedAt    DateTime         @updatedAt
}

// ===========================================================================
// CMS  (PRD §18, §47)
// ===========================================================================

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  status          ContentStatus @default(PUBLISHED)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sections PageSection[]

  @@index([status])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  key       String
  type      String
  title     String?
  subtitle  String?
  body      String?
  data      Json?
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@index([pageId, position])
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String
  content         String
  coverImage      String?
  authorId        String?
  categoryId      String?
  readMinutes     Int           @default(5)
  status          ContentStatus @default(PUBLISHED)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   User?         @relation(fields: [authorId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  tags     BlogPostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model Category {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model Tag {
  id    String        @id @default(cuid())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model CaseStudy {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  client          String
  industry        String
  summary         String
  challenge       String
  solution        String
  outcome         String
  /// Concrete ROI metrics, never invented claims (PRD §7, §48.1)
  metrics         Json?
  services        String[]
  coverImage      String?
  status          ContentStatus @default(PUBLISHED)
  featured        Boolean       @default(false)
  position        Int           @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, featured])
  @@index([industry])
  @@index([position])
}

model Industry {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  headline    String
  description String
  challenges  String[]
  solutions   String[]
  icon        String?
  status      ContentStatus @default(PUBLISHED)
  position    Int           @default(0)

  @@index([status, position])
}

model Testimonial {
  id        String        @id @default(cuid())
  author    String
  role      String
  company   String?
  quote     String
  avatarUrl String?
  rating    Int           @default(5)
  status    ContentStatus @default(PUBLISHED)
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([status, position])
}

model FAQ {
  id       String        @id @default(cuid())
  question String
  answer   String
  category String        @default("General")
  status   ContentStatus @default(PUBLISHED)
  position Int           @default(0)

  @@index([status, position])
  @@index([category])
}

model NavigationItem {
  id       String  @id @default(cuid())
  location String // HEADER | FOOTER_SERVICES | FOOTER_COMPANY | FOOTER_LEGAL
  label    String
  href     String
  parentId String?
  position Int     @default(0)
  enabled  Boolean @default(true)

  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavChildren")

  @@index([location, position])
  @@index([parentId])
}

model TeamMember {
  id        String        @id @default(cuid())
  name      String
  role      String
  bio       String
  avatarUrl String?
  linkedin  String?
  status    ContentStatus @default(PUBLISHED)
  position  Int           @default(0)

  @@index([status, position])
}

// ===========================================================================
// MEDIA  (PRD §19 Media domain)
// ===========================================================================

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  folderId     String?
  uploadedById String?
  name         String
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime @default(now())

  folder     MediaFolder? @relation(fields: [folderId], references: [id])
  uploadedBy User?        @relation(fields: [uploadedById], references: [id])

  @@index([folderId])
  @@index([uploadedById])
  @@index([createdAt])
}

// ===========================================================================
// SYSTEM: settings, payments config, tracking, maintenance, audit  (§45, §46, §49)
// ===========================================================================

/// Key/value store behind the Global Settings Panel (PRD §46). Values are
/// structured JSON written by validated forms only — never free-form code.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model PaymentMethodConfig {
  id            String           @id @default(cuid())
  method        PaymentMethodKey @unique
  label         String
  isActive      Boolean          @default(false)
  accountName   String?
  accountNumber String?
  branch        String?
  instructions  String?
  minAmount     Decimal?         @db.Decimal(12, 2)
  maxAmount     Decimal?         @db.Decimal(12, 2)
  /// Gateway credentials stay server-side and are masked in the UI (§43.1).
  credentials   Json?
  position      Int              @default(0)
  updatedAt     DateTime         @updatedAt

  @@index([isActive])
}

model MaintenanceNotice {
  id               String    @id @default("singleton")
  bannerText       String    @default("")
  startAt          DateTime?
  endAt            DateTime?
  isBannerActive   Boolean   @default(false)
  isFullModeActive Boolean   @default(false)
  updatedAt        DateTime  @updatedAt
}

model TrackingConfig {
  id            String   @id @default("singleton")
  ga4Id         String?
  gtmId         String?
  clarityId     String?
  metaPixelId   String?
  /// Server-side only — never serialized into a client bundle (§44.2).
  metaCapiToken String?
  metaDatasetId String?
  updatedAt     DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  description String
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Integration {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  category  String
  isEnabled Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Append-oriented record of every sensitive mutation (PRD §26, §41.6).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  type      String // LOGIN_FAILED | RATE_LIMITED | PASSWORD_RESET | SUSPICIOUS
  detail    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type, createdAt])
  @@index([createdAt])
}

/// Newsletter opt-ins from the footer form.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
